---
import { Image } from 'astro:assets';
import type { Project } from '../../lib/content';
import { projectHref } from '../../lib/content';
import { maturityLabel } from '../../lib/maturity';
import Tag from '../primitives/Tag.astro';

/**
 * /projects 列表用的紧凑行。
 * 列表页的目标是「快速扫完并决定点哪个」，所以这里只给：
 *   编号 → 项目名 → 真实用户 → 一句话价值 → 入口
 * 完整问题陈述放在详情页。
 */
interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;

const href = projectHref(project.id);
const isConcept = data.maturity === 'concept';
const demo = isConcept ? undefined : data.links.demo;
const users = isConcept ? null : data.users;
const userLabel = users ? (users.count ? `${users.count} 位用户` : users.who) : null;

const gallery = isConcept ? data.diagrams : data.gallery;
const thumb = gallery.find((g) => g.isCover) ?? gallery[0];
---

<article
  class="group relative border-b border-line last:border-b-0"
  data-reveal
>
  <div class="flex items-start gap-5 py-7 sm:gap-7">
    {
      thumb && (
        <div class="hidden size-14 shrink-0 overflow-hidden rounded-md border border-line bg-bg-subtle sm:block">
          <Image
            src={thumb.src}
            alt=""
            widths={[112]}
            loading="lazy"
            class="size-full object-cover"
          />
        </div>
      )
    }

    <div class="min-w-0 flex-1">
      <h3 class="t-h3 text-ink">
        <a
          href={href}
          class="before:absolute before:inset-0 transition-colors duration-150 group-hover:text-accent-ink"
        >
          {data.title}
        </a>
      </h3>

      <div class="mt-2.5 flex flex-wrap items-center gap-2">
        <Tag tone={data.maturity === 'iterating' ? 'accent' : 'neutral'}>
          {maturityLabel[data.maturity]}
        </Tag>
        {userLabel && <Tag>{userLabel}</Tag>}
      </div>

      <p class="t-small mt-3 max-w-[60ch] text-ink-2">{data.subtitle}</p>
    </div>

    <!-- 入口独立于卡片点击区，抬到覆盖层之上 -->
    <div class="relative z-10 flex shrink-0 flex-col items-end gap-2.5">
      {
        demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener"
            class="t-micro font-medium whitespace-nowrap text-accent-ink transition-opacity duration-150 hover:opacity-75"
          >
            打开产品 <span aria-hidden="true">↗</span>
          </a>
        )
      }
      <span
        class="t-micro whitespace-nowrap text-ink-3 transition-transform duration-150 group-hover:translate-x-0.5"
        aria-hidden="true"
      >
        案例 →
      </span>
    </div>
  </div>
</article>
