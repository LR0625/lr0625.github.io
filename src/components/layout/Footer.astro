---
import { site } from '../../data/site';
---

<footer class="mt-24 border-t border-line">
  <div class="container-page py-12">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="t-small font-semibold tracking-tight text-ink">
          {site.name} <span class="text-ink-3">·</span> {site.brand}
        </p>
        <p class="mt-1 text-sm text-ink-2">{site.role}</p>
        <p class="mt-0.5 text-sm text-ink-3">{site.axes}</p>
      </div>

      <div class="flex flex-col gap-3 text-sm sm:items-end">
        <a
          href={`mailto:${site.contact.email}`}
          class="text-ink-2 transition-colors duration-150 hover:text-accent-ink"
        >
          {site.contact.email}
        </a>
        <a
          href={site.contact.github}
          rel="me noopener"
          target="_blank"
          class="text-ink-2 transition-colors duration-150 hover:text-accent-ink"
        >
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <a
          href={site.resume}
          download
          class="text-ink-2 transition-colors duration-150 hover:text-accent-ink"
        >
          简历 PDF <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-line pt-6 text-xs text-ink-3 sm:flex-row sm:justify-between">
      <p>© {new Date().getFullYear()} {site.name}</p>
      <p>
        Astro · Tailwind CSS · 静态生成
      </p>
    </div>
  </div>
</footer>
