---
import { site } from '../../data/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;

function isActive(href: string) {
  const base = href.replace(/\/$/, '');
  return path === href || path === base || path.startsWith(base + '/');
}

const linkBase =
  'rounded-md px-2 py-1.5 t-micro transition-colors duration-150 sm:px-3 sm:text-sm';
---

<header
  class="sticky top-0 z-50 border-b border-transparent bg-bg/80 backdrop-blur-md transition-colors duration-150"
  data-site-header
>
  <div class="container-page flex h-14 items-center justify-between gap-3">
    <a
      href="/"
      class="shrink-0 t-small font-semibold tracking-tight text-ink transition-opacity duration-150 hover:opacity-70"
    >
      {site.name}
    </a>

    <nav aria-label="主导航" class="flex items-center gap-0.5 sm:gap-1">
      {
        site.nav.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                linkBase,
                active ? 'text-ink' : 'text-ink-2 hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex shrink-0 items-center gap-1 sm:gap-2">
      <a
        href={site.resume}
        class="hidden rounded-md border border-line px-2.5 py-1.5 t-micro text-ink-2 transition-colors duration-150 hover:border-line-strong hover:text-ink sm:inline-block"
        download
      >
        Résumé
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  // 滚动后出现发丝分割线：静止时不显示边框，减少视觉噪声
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const onScroll = () => {
      header.classList.toggle('border-line', window.scrollY > 8);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
