---
/**
 * 时间线容器。把「什么时候发生了什么」从叙述里抽出来，
 * 让招聘者能一眼看到事情推进的节奏。
 */
interface Props {
  label?: string;
}

const { label } = Astro.props;
---

<div class="tl">
  {label && <p class="tl__label">{label}</p>}
  <ol>
    <slot />
  </ol>
</div>

<style is:global>
  .tl {
    margin-block: 2em;
  }

  .tl__label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0 0 1.1rem;
  }

  .tl ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tl-item {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1.1rem;
    padding-bottom: 1.4rem;
    padding-left: 1.1rem;
  }

  .tl-item:last-child {
    padding-bottom: 0;
  }

  /* 竖线 */
  .tl-item:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 1.1rem;
    bottom: 0;
    width: 1px;
    background: var(--border);
  }

  /* 节点 */
  .tl-item::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--border-strong);
  }

  .tl-item--key::after {
    background: var(--accent);
    width: 7px;
    height: 7px;
    left: -1px;
  }

  .tl-item__when {
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-tertiary);
    line-height: 1.7;
  }

  .tl-item__title {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.6;
    color: var(--text);
    margin: 0;
  }

  .tl-item--key .tl-item__title {
    color: var(--accent-ink);
  }

  .tl-item__note {
    margin: 0.3rem 0 0;
    font-size: 0.83rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .tl-item {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
